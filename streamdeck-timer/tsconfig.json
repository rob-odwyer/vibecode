{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": false,
    "moduleDetection": "force",
    "rootDir": "src",
    "outDir": "com.robodwyer.timer.sdPlugin/bin"
  },
  "include": ["src/**/*"]
}
