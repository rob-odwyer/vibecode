# ---- General -------------------------------------------------------------
TIMEZONE=Europe/London              # IANA zone used to interpret chat times and write events
WACAL_SOURCE=export                 # whatsmeow | export | inbox
WACAL_DEFAULT_LOOKBACK_DAYS=7       # first run only (no cursor yet)
WACAL_FETCH_LIMIT=300
WACAL_MIN_CONFIDENCE=0.6
# WACAL_STATE_DIR=./state           # cursor + token + sqlite live here

# ---- State sync for remote routines (Google Drive, drive.file scope) -----
# WACAL_STATE_SYNC=drive            # pull/push state around every bridge run
# WACAL_DRIVE_FOLDER=wacal-state
# WACAL_STATE_PASSPHRASE=...        # encrypt state at rest (recommended)
# WACAL_STATE_LOCK_TTL_MIN=30

# ---- Google Calendar (OAuth "Desktop app" client) ------------------------
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_CALENDAR_ID=primary
# Optional: instead of state/google_token.json (useful for a routine whose
# container starts fresh each run). Get it from google_auth.py --print-refresh-token
# GOOGLE_REFRESH_TOKEN=...

# ---- Source: whatsmeow (Go bridge in ./bridge, linked-device protocol) ---
# WACAL_WA_BRIDGE_BIN=./bridge/wa-bridge
# WACAL_WA_CHAT_ID=120363000000000000@g.us   # fetch only this chat (wa-bridge groups)
# WACAL_WA_CHATS=120363000000000000@g.us     # bridge stores only these (comma-separated)
# WACAL_WA_FETCH_WAIT=20s
# WACAL_WA_SESSION_DB=./state/whatsmeow.db
# WACAL_WA_MESSAGES_DB=./state/wa-messages.sqlite3
# WACAL_WA_LOG_LEVEL=WARN

# ---- Source: export (WhatsApp "Export chat" .txt files) ------------------
WACAL_EXPORT_DIR=./inbox-exports
WACAL_EXPORT_DATE_ORDER=DMY         # DMY or MDY, matches your phone's locale
# WACAL_EXPORT_CHAT_ID=family-group # label; defaults to the file name

# ---- Source: inbox (WhatsApp Business Cloud API via scripts/inbox_server.py)
# WACAL_INBOX_URL=https://inbox.example.com
# WACAL_INBOX_TOKEN=long-random-string
# WACAL_INBOX_CHAT_ID=              # optional filter
# --- only the server needs these:
# WACAL_META_VERIFY_TOKEN=another-random-string
# WACAL_META_APP_SECRET=from-meta-app-dashboard
# WACAL_INBOX_DB=./state/inbox.sqlite3
# PORT=8080
